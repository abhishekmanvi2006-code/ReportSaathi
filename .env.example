# ReportSaathi Environment Configuration
# Copy this file to .env in production or for customized local settings.
# NEVER commit the actual .env file with real secrets to version control.

# Backend Settings
SECRET_KEY=django-insecure-reportsaathi-local-dev-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Settings (Allow frontend to connect)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Settings (Defaults to SQLite for local development)
DATABASE_URL=sqlite:///backend/db.sqlite3

# AI & Document Processing (Gemini API)
# Get a key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# OCR & Tesseract (Optional local path if custom installed on Windows)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
